# ==============================================================================
# STRATUM PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# SUPABASE POSTGRES DATABASE (CLOUD)
# ------------------------------------------------------------------------------
# Transaction Pooler (port 6543) - Used by Next.js & Hono runtime for high-concurrency pooling
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (port 5432) - Used strictly for Drizzle migrations & Drizzle Kit schema push
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Cloud Project API Credentials (for Storage, Realtime, Edge Functions if used)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# BETTER AUTH (SCALABLE OPEN-SOURCE AUTHENTICATION)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-character-random-secret-key-stratum-2026"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers (Optional / Configure as needed)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# APPLICATION URLS & CONFIG
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api"
